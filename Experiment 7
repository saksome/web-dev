
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NoteSpace - Notes App</title>

  <!-- React CDN -->
  <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f6f2;
      color: #263329;
      line-height: 1.6;
    }

    header {
      background: #fff;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #e4e7df;
    }

    .logo {
      color: #365b40;
      font-size: 24px;
      font-weight: bold;
    }

    .status {
      font-size: 13px;
      color: #4b7752;
    }

    main {
      max-width: 1050px;
      width: 92%;
      margin: 35px auto;
    }

    .hero {
      text-align: center;
      margin-bottom: 30px;
    }

    .hero h1 {
      font-size: clamp(28px, 5vw, 40px);
      margin-bottom: 8px;
    }

    .hero h1 span {
      color: #47754e;
    }

    .hero p {
      color: #777e75;
    }

    .panel {
      background: white;
      border: 1px solid #e3e7df;
      border-radius: 14px;
      padding: 25px;
      margin-bottom: 35px;
      box-shadow: 0 4px 15px #26332908;
    }

    .panel h2 {
      margin-bottom: 16px;
      font-size: 21px;
    }

    label {
      display: block;
      font-weight: bold;
      font-size: 13px;
      margin-bottom: 6px;
    }

    input, textarea {
      width: 100%;
      padding: 12px;
      margin-bottom: 17px;
      border: 1px solid #dce1d8;
      border-radius: 8px;
      font: inherit;
      font-size: 14px;
      outline: none;
    }

    input:focus, textarea:focus {
      border-color: #57815c;
      box-shadow: 0 0 0 3px #57815c18;
    }

    textarea {
      resize: vertical;
      min-height: 110px;
    }

    .form-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    button {
      border: none;
      padding: 10px 17px;
      border-radius: 7px;
      cursor: pointer;
      font-size: 13px;
      font-weight: bold;
    }

    .primary {
      background: #3e6847;
      color: white;
    }

    .primary:hover {
      background: #2d5236;
    }

    .secondary {
      background: #edf0e9;
      color: #344d37;
    }

    .delete {
      background: #fae9e6;
      color: #a03c32;
    }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
    }

    .toolbar h2 {
      font-size: 22px;
    }

    .toolbar input {
      max-width: 280px;
      margin: 0;
      background: white;
    }

    .count {
      color: #57815c;
      font-size: 14px;
    }

    .notes-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .note {
      background: white;
      border: 1px solid #e1e6dd;
      border-radius: 12px;
      padding: 19px;
      min-width: 0;
      display: flex;
      flex-direction: column;
      overflow-wrap: anywhere;
    }

    .note:nth-child(4n + 2) {
      background: #f0f5eb;
    }

    .note:nth-child(4n + 3) {
      background: #fff5e9;
    }

    .note:nth-child(4n + 4) {
      background: #f3f0fa;
    }

    .note-date {
      color: #7d847a;
      font-size: 11px;
      margin-bottom: 12px;
    }

    .note h3 {
      font-size: 17px;
      margin-bottom: 8px;
    }

    .note-content {
      color: #646b62;
      font-size: 14px;
      white-space: pre-wrap;
      margin-bottom: 20px;
    }

    .note-actions {
      display: flex;
      gap: 8px;
      margin-top: auto;
      padding-top: 12px;
      border-top: 1px solid #00000010;
    }

    .note-actions button {
      padding: 8px 12px;
    }

    .empty {
      background: white;
      padding: 45px 15px;
      text-align: center;
      border: 1px dashed #d4dbd0;
      border-radius: 12px;
      color: #737b70;
    }

    .empty h3 {
      color: #344237;
      margin-bottom: 7px;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #7b8278;
      font-size: 12px;
    }

    @media (max-width: 800px) {
      .notes-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 540px) {
      header {
        padding: 15px 4%;
      }

      main {
        width: 92%;
        margin-top: 25px;
      }

      .panel {
        padding: 18px;
      }

      .notes-grid {
        grid-template-columns: 1fr;
      }

      .toolbar {
        align-items: stretch;
        flex-direction: column;
      }

      .toolbar input {
        max-width: none;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="logo">✎ NoteSpace</div>
    <div class="status">● Saved locally</div>
  </header>

  <div id="root"></div>

  <footer>NoteSpace © <span id="year"></span> | Your ideas, organized.</footer>

  <script>
    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>

  <script type="text/babel">
    const { useState, useEffect } = React;
    const STORAGE_KEY = "notespace-notes";

    function loadNotes() {
      try {
        const data = JSON.parse(
          localStorage.getItem(STORAGE_KEY) || "[]"
        );
        return Array.isArray(data) ? data : [];
      } catch {
        return [];
      }
    }

    function App() {
      const [notes, setNotes] = useState(loadNotes);
      const [title, setTitle] = useState("");
      const [content, setContent] = useState("");
      const [search, setSearch] = useState("");
      const [editingId, setEditingId] = useState(null);

      useEffect(() => {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(notes));
      }, [notes]);

      function resetForm() {
        setTitle("");
        setContent("");
        setEditingId(null);
      }

      function handleSubmit(event) {
        event.preventDefault();

        const cleanTitle = title.trim();
        const cleanContent = content.trim();

        if (!cleanTitle || !cleanContent) {
          alert("Please enter both a title and description.");
          return;
        }

        if (editingId !== null) {
          setNotes(current =>
            current.map(note =>
              note.id === editingId
                ? {
                    ...note,
                    title: cleanTitle,
                    content: cleanContent,
                    updatedAt: new Date().toISOString()
                  }
                : note
            )
          );
        } else {
          setNotes(current => [
            {
              id: Date.now().toString() +
                  Math.random().toString(36).slice(2),
              title: cleanTitle,
              content: cleanContent,
              createdAt: new Date().toISOString()
            },
            ...current
          ]);
        }

        resetForm();
      }

      function editNote(note) {
        setTitle(note.title);
        setContent(note.content);
        setEditingId(note.id);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function deleteNote(id) {
        if (!window.confirm("Are you sure you want to delete this note?")) {
          return;
        }

        setNotes(current =>
          current.filter(note => note.id !== id)
        );

        if (editingId === id) {
          resetForm();
        }
      }

      const filteredNotes = notes.filter(note =>
        (note.title + " " + note.content)
          .toLowerCase()
          .includes(search.trim().toLowerCase())
      );

      function formatDate(date) {
        return new Date(date).toLocaleDateString(undefined, {
          month: "short",
          day: "numeric",
          year: "numeric"
        });
      }

      return (
        <main>
          <section className="hero">
            <h1>Your thoughts, <span>organized.</span></h1>
            <p>Create, manage, and find your notes in one place.</p>
          </section>

          <section className="panel">
            <h2>
              {editingId !== null ? "Edit Note" : "Create a Note"}
            </h2>

            <form onSubmit={handleSubmit}>
              <label htmlFor="title">Note Title</label>
              <input
                id="title"
                type="text"
                placeholder="Enter note title..."
                value={title}
                onChange={event => setTitle(event.target.value)}
                maxLength={120}
                required
              />

              <label htmlFor="content">Description</label>
              <textarea
                id="content"
                placeholder="Write your note here..."
                value={content}
                onChange={event => setContent(event.target.value)}
                maxLength={10000}
                required
              />

              <div className="form-actions">
                <button className="primary" type="submit">
                  {editingId !== null ? "Save Changes" : "+ Add Note"}
                </button>

                {editingId !== null && (
                  <button
                    className="secondary"
                    type="button"
                    onClick={resetForm}
                  >
                    Cancel
                  </button>
                )}
              </div>
            </form>
          </section>

          <section>
            <div className="toolbar">
              <h2>
                My Notes <span className="count">({notes.length})</span>
              </h2>

              <input
                type="search"
                aria-label="Search notes"
                placeholder="Search notes..."
                value={search}
                onChange={event => setSearch(event.target.value)}
              />
            </div>

            {filteredNotes.length > 0 ? (
              <div className="notes-grid">
                {filteredNotes.map(note => (
                  <article className="note" key={note.id}>
                    <div className="note-date">
                      {formatDate(note.updatedAt || note.createdAt)}
                    </div>

                    <h3>{note.title}</h3>
                    <p className="note-content">{note.content}</p>

                    <div className="note-actions">
                      <button
                        className="secondary"
                        type="button"
                        onClick={() => editNote(note)}
                      >
                        Edit
                      </button>

                      <button
                        className="delete"
                        type="button"
                        onClick={() => deleteNote(note.id)}
                      >
                        Delete
                      </button>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div className="empty">
                <h3>
                  {search ? "No notes found" : "No notes yet"}
                </h3>
                <p>
                  {search
                    ? "Try searching with another keyword."
                    : "Create your first note using the form above."}
                </p>
                {search && (
                  <button
                    className="secondary"
                    style={{ marginTop: 15 }}
                    onClick={() => setSearch("")}
                  >
                    Clear Search
                  </button>
                )}
              </div>
            )}
          </section>
        </main>
      );
    }

    const root = ReactDOM.createRoot(
      document.getElementById("root")
    );
    root.render(<App />);
  </script>
</body>
</html>
